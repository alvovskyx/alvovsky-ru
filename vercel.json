{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.alvovsky.ru"
        }
      ],
      "destination": "https://alvovsky.ru/$1",
      "permanent": true
    },
    {
      "source": "/guardian",
      "destination": "/privacyguard/",
      "permanent": true
    },
    {
      "source": "/guardian/",
      "destination": "/privacyguard/",
      "permanent": true
    },
    {
      "source": "/guardian/:path*",
      "destination": "/privacyguard/",
      "permanent": true
    },
    {
      "source": "/razbor/",
      "destination": "/privacyguard/",
      "permanent": false
    },
    {
      "source": "/razbor/:path*",
      "destination": "/privacyguard/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ru/probe",
      "destination": "/probe/index.html"
    },
    {
      "source": "/ru/probe/",
      "destination": "/probe/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
